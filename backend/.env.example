# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS origin allowlist
CLIENT_URL=http://localhost:5173

# Database Connection (Leave empty locally to use automatic in-memory MongoDB)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chat_db?retryWrites=true&w=majority

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (For profile pictures and message images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
